@startuml architecture
title 任务 10 · V3.1 三层架构类图\ncom.campus.reservation
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 14
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 55
hide empty members
set separator none
top to bottom direction

class SystemMain #EDF2F7 {
  + {static} main(args : String[]) : void
}
package "ui.console · 交互展示" #E9F4FF {
  class ConsoleUI {
    - userService : UserOperations
    - resourceService : ResourceOperations
    - reserveService : ReserveOperations
    + run() : int
    + {static} printBanner() : void
    + {static} showStartupError(message : String) : void
    - displayResult(result : Result<?>) : void
    - runResourceMenu(scanner : Scanner, user : User) : boolean
  }
}
package "service · 业务校验与流程" #EFF9EE {
  interface UserOperations {
    + initializeDefaultAdministrator() : Result<Void>
    + checkUsername(username : String) : Result<Void>
    + registerUser(username : String, password : String) : Result<User>
    + loginUser(username : String, password : String) : Result<User>
    + findUserByUsername(username : String) : Result<User>
  }
  interface ResourceOperations {
    + addResource(user : User, name : String, type : String, location : String) : Result<CampusResource>
    + queryResources(user : User, keyword : String) : Result<List<CampusResource>>
    + updateResource(user : User, id : String, name : String, type : String, location : String, status : String) : Result<CampusResource>
    + deleteResource(user : User, id : String) : Result<Void>
  }
  interface ReserveOperations {
    + submitReservation(user : User, resourceId : String, start : LocalDateTime, end : LocalDateTime, remark : String) : Result<ReserveRecord>
    + queryMyReservations(user : User) : Result<List<ReserveRecord>>
    + queryAllReservations(user : User) : Result<List<ReserveRecord>>
    + filterReservations(user : User, resourceId : String, applicant : String, status : ReserveStatus) : Result<List<ReserveRecord>>
    + auditReservation(user : User, recordId : String, decision : ReserveStatus, remark : String) : Result<ReserveRecord>
    + cancelReservation(user : User, recordId : String) : Result<ReserveRecord>
  }
  class UserService {
    - {static} DEFAULT_ADMIN_USERNAME : String
    - {static} DEFAULT_ADMIN_PASSWORD : String
    - userDao : UserDao
    + UserService(userDao : UserDao)
  }
  class ResourceService {
    - resourceDao : ResourceDao
    - reserveDao : ReserveRecordDao
    + ResourceService(resourceDao : ResourceDao, reserveDao : ReserveRecordDao)
  }
  class ReserveService {
    - resourceDao : ResourceDao
    - reserveDao : ReserveRecordDao
    + ReserveService(resourceDao : ResourceDao, reserveDao : ReserveRecordDao)
    - findReserveById(recordId : String) : Result<ReserveRecord>
  }
  class BusinessRules <<package-private>> {
    ~ {static} requireAdministrator(user : User) : void
    ~ {static} requireStudent(user : User, message : String) : void
    ~ {static} validateNotEmpty(value : String, fieldName : String) : void
    ~ {static} findResourceById(resourceDao : ResourceDao, id : String) : Result<CampusResource>
    ~ {static} hasPassedReservation(records : List<ReserveRecord>, resourceId : String) : boolean
  }
}
package "dao · 集合与文件 CRUD" #FFF4E4 {
  class UserDao {
    - {static} USER_FILE : Path
    - items : List<User>
    + UserDao()
    + findAll() : List<User>
    + findByUsername(key : String) : Optional<User>
    + insert(item : User) : void
    + update(item : User) : void
    + delete(key : String) : void
    + saveAll(updated : List<User>) : void
  }
  class ResourceDao {
    - {static} RESOURCE_FILE : Path
    - items : List<CampusResource>
    + ResourceDao()
    + findAll() : List<CampusResource>
    + findById(key : String) : Optional<CampusResource>
    + insert(item : CampusResource) : void
    + update(item : CampusResource) : void
    + delete(key : String) : void
    + saveAll(updated : List<CampusResource>) : void
  }
  class ReserveRecordDao {
    - {static} RESERVE_FILE : Path
    - items : List<ReserveRecord>
    + ReserveRecordDao()
    + findAll() : List<ReserveRecord>
    + findByRecordId(key : String) : Optional<ReserveRecord>
    + insert(item : ReserveRecord) : void
    + update(item : ReserveRecord) : void
    + delete(key : String) : void
    + saveAll(updated : List<ReserveRecord>) : void
  }
}
package "utils · 通用 IO 辅助" #F3EDFA {
  class FileUtil <<utility>> {
    - FileUtil()
    + {static} ensureFile(file : Path) : void
    + {static} replaceFile(temporary : Path, target : Path) : void
    + {static} escape(value : String) : String
    + {static} unescape(value : String) : String
    + {static} stripBom(line : String, lineNumber : int) : String
  }
}
package "entity · 数据模型（字段见 models 图）" #F4F7FA {
  class User
  class CampusResource
  class ReserveRecord
  enum ReserveStatus
  class "Result<T>" as Result
}
package "exception · 业务异常（继承见 exceptions 图）" #FDEEEE {
  class BusinessException
}

SystemMain ..> ConsoleUI : 创建并启动
note right of SystemMain
  装配入口创建 DAO、Service、UI 并注入共享实例。
  不执行业务；为减少交叉线，省略其余创建依赖。
end note
ConsoleUI --> UserOperations
ConsoleUI --> ResourceOperations
ConsoleUI --> ReserveOperations
UserOperations <|.. UserService
ResourceOperations <|.. ResourceService
ReserveOperations <|.. ReserveService
UserService --> UserDao
ResourceService --> ResourceDao
ResourceService --> ReserveRecordDao
ReserveService --> ResourceDao
ReserveService --> ReserveRecordDao
UserService ..> BusinessRules
ResourceService ..> BusinessRules
ReserveService ..> BusinessRules
BusinessRules ..> ResourceDao : 主键查询
BusinessRules ..> BusinessException : 抛出
ConsoleUI ..> BusinessException : 输入错误提示
UserDao ..> FileUtil
ResourceDao ..> FileUtil
ReserveRecordDao ..> FileUtil
UserDao "1" o-- "0..*" User : items
ResourceDao "1" o-- "0..*" CampusResource : items
ReserveRecordDao "1" o-- "0..*" ReserveRecord : items
ReserveRecord --> ReserveStatus : status
ReserveOperations ..> Result : 返回

note bottom of BusinessRules
  服务实现接口上全部方法；此图只列核心成员。
  角色权限、时间冲突和状态联动均在 service。
  dao 只做主键、文件格式校验及数据存取。
end note
legend bottom
  + public    - private    ~ package-private
  实线箭头：持有依赖；虚线箭头：使用依赖；空心三角虚线：接口实现
  空心菱形：集合聚合。entity 为三层共同使用的数据类型，无反向调用。
  DAO 仍为具体类；本阶段接口隔离和依赖倒置落在 UI → 三个业务接口。
endlegend
@enduml
